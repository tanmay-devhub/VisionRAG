# ── VisionRAG Phase 4: Ollama Cloud Video ─────────────────────────────────────
# File: backend/.env.example
# Changes: Added video cloud section
# Image pipeline: UNTOUCHED
# ─────────────────────────────────────────────────────────────────────────────

# Copy this file to .env and fill in the values for your chosen vision backend.

# ── LLM (answer generation) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# ── Vision backend (images only — local Ollama) ────────────────────────────────
# Options: ollama | paligemma | gemini | openai
VISION_BACKEND=ollama
OLLAMA_VISION_MODEL=qwen3-vl:8b

# PaliGemma (set VISION_BACKEND=paligemma)
# 1. Accept the license at https://huggingface.co/google/paligemma2-3b-ft-docci-448
# 2. Get a token at https://huggingface.co/settings/tokens
PALIGEMMA_MODEL=google/paligemma2-3b-ft-docci-448
HF_TOKEN=

# Gemini (set VISION_BACKEND=gemini)
GEMINI_API_KEY=

# OpenAI (set VISION_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── Job Store ──────────────────────────────────────────────────────────────────
JOB_STORE_PATH=./jobs.db

# ── Storage ────────────────────────────────────────────────────────────────────
FIGURES_DIR=../static/figures
FIGURES_SERVE_URL=http://localhost:8081/figures
EMBED_MODEL=all-MiniLM-L6-v2

# ── Retrieval tuning ───────────────────────────────────────────────────────────
# How many candidates to pass to the CrossEncoder reranker (top_k * this).
RERANK_CANDIDATE_MULTIPLIER=3

# ── Video ingest (Ollama Cloud) ──────────────────────────────────────────────────
# Cloud model for video — runs on Ollama's datacenter GPUs, not local.
# Run first: ollama pull qwen3-vl:235b-instruct-cloud
VIDEO_CLOUD_MODEL=qwen3-vl:235b-instruct-cloud

# Max video duration in seconds. Videos longer than this are rejected at upload.
VIDEO_MAX_DURATION_SEC=180

# Request timeout for each cloud API call (seconds).
VIDEO_REQUEST_TIMEOUT=300

# Scene detection threshold (lower = more frames detected).
# 0.25 catches most transitions in dynamic videos.
VIDEO_SCENE_THRESHOLD=0.25

# Frame limits: scene detection fills to MIN, caps at MAX.
# For 3-min video: 45 frames = one every 4 seconds.
VIDEO_MAX_FRAMES=45
VIDEO_MIN_FRAMES=15

# Frame resolution (width in pixels). 640 balances quality and size.
VIDEO_FRAME_WIDTH=640

# ── Docker overrides (set automatically via docker-compose environment:) ───────
# OLLAMA_BASE_URL=http://visionrag-ollama:11434
# NEO4J_URI=bolt://visionrag-neo4j:7687
