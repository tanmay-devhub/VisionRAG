# ── VisionRAG Phase 4b: Gemini Video Pipeline ─────────────────────────────────
# File: backend/.env.example
# Changes: Added Gemini video backend section
# Image pipeline: UNTOUCHED
# Ollama video pipeline: UNTOUCHED
# ─────────────────────────────────────────────────────────────────────────────

# Copy this file to .env and fill in the values for your chosen backends.

# ── LLM (answer generation) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# ── Image vision backend (local Ollama) ────────────────────────────────────────
# Options: ollama | paligemma | gemini | openai
VISION_BACKEND=ollama
OLLAMA_VISION_MODEL=qwen3-vl:8b

# PaliGemma (set VISION_BACKEND=paligemma)
PALIGEMMA_MODEL=google/paligemma2-3b-ft-docci-448
HF_TOKEN=

# OpenAI (set VISION_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── Job Store ──────────────────────────────────────────────────────────────────
JOB_STORE_PATH=./jobs.db

# ── Storage ────────────────────────────────────────────────────────────────────
FIGURES_DIR=../static/figures
FIGURES_SERVE_URL=http://localhost:8081/figures
EMBED_MODEL=all-MiniLM-L6-v2

# ── Retrieval tuning ───────────────────────────────────────────────────────────
RERANK_CANDIDATE_MULTIPLIER=3

# ── Video ingest: Ollama Cloud backend ───────────────────────────────────────────
# Frame-by-frame pipeline via Ollama Cloud (qwen3-vl:235b).
# Used when video_backend=ollama (or default if Gemini not configured).
VIDEO_CLOUD_MODEL=qwen3-vl:235b-instruct-cloud
VIDEO_MAX_DURATION_SEC=180
VIDEO_REQUEST_TIMEOUT=300
VIDEO_SCENE_THRESHOLD=0.25
VIDEO_MAX_FRAMES=45
VIDEO_MIN_FRAMES=15
VIDEO_FRAME_WIDTH=640
# Number of frames described in parallel. 3 = safe for most Ollama Cloud setups.
# Increase to 5 for faster ingest if your cloud tier allows concurrent requests.
VIDEO_PARALLEL_FRAMES=3

# ── Video ingest: Gemini backend ─────────────────────────────────────────────────
# Native video pipeline — sends entire video to Gemini, no frame extraction.
# Used when video_backend=gemini.
# Get a free API key: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day, no credit card required.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_VIDEO_TIMEOUT=300

# ── Docker overrides (set automatically via docker-compose environment:) ───────
# OLLAMA_BASE_URL=http://visionrag-ollama:11434
# NEO4J_URI=bolt://visionrag-neo4j:7687

# ── Security ─────────────────────────────────────────────────────────────────────
# API key for authentication. Leave empty for dev mode (no auth).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISIONRAG_API_KEY=

# Max upload file size in MB. Default 100MB.
MAX_FILE_SIZE_MB=100

# Rate limit: max requests per minute per IP.
RATE_LIMIT_RPM=60

# ── Source filtering ───────────────────────────────────────────────────────────
# Minimum relevance score (0.0-1.0). Sources below this are filtered out.
# 0.01 = 1%. Filters true zero-relevance noise; lets category-level matches through.
# The reranker already sorts by relevance — the threshold only removes absolute noise.
MIN_SOURCE_SCORE=0.01

# ── Gemini Usage Tracking ──────────────────────────────────────────────────────
# Local tracker counts every Gemini API call and resets daily at midnight Pacific.
# Expose via /health → gemini_usage.{requests_today, remaining, daily_limit}
GEMINI_TRACKER_PATH=./gemini_usage.json

# Daily request limit. Default 1500 (gemini-2.5-flash free tier).
# Set to 50 if using gemini-2.5-pro (heavily restricted on free tier).
GEMINI_DAILY_LIMIT=1500
